# Copy this file to .env and fill it in with the TEST project's values.
# NEVER put the real (production) project here. The scripts refuse to run
# against the production project ref.

# Test project: Project Settings -> API keys
TEST_SUPABASE_URL=https://your-test-project-ref.supabase.co
# Publishable / anon key (the same kind of key the web app uses)
TEST_SUPABASE_ANON_KEY=
# Secret / service_role key (full admin access to the TEST project; keep private)
TEST_SUPABASE_SERVICE_ROLE_KEY=

# --- How much test data to create ---
# load/spike use the first 1000 students; stress ramps up to all of them
STUDENTS=2000
INSTRUCTORS=100
# separate exams, so students can take more than one exam in stress/soak runs
ROUNDS=10
# questions per exam
QUESTIONS=50
# the big exams are shared across this many sections
SECTIONS_PER_EXAM=20
# completed attempts pre-filled for the instructor results-page test
RESULTS_EXAM_TAKERS=1000
EXAM_MINUTES=60

# Sign-in pacing when collecting login tokens (Supabase limits sign-ins per IP)
TOKEN_CONCURRENCY=3
